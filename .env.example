# Twitch (https://dev.twitch.tv/console/apps) — app access token, sem login do usuário
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# YouTube — gerado por scripts/youtube_auth.py
YOUTUBE_CLIENT_SECRETS=secrets/youtube_client_secret.json
YOUTUBE_TOKEN_FILE=secrets/youtube_token.json

# TikTok (https://developers.tiktok.com) — Content Posting API
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://seu-dominio.com/tiktok/callback
TIKTOK_TOKEN_FILE=secrets/tiktok_token.json
